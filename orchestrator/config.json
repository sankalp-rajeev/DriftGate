{
  "region": "us-east-1",
  "branch": "main",
  "run_bucket": "",
  "run_prefix": "runs/",
  "build": {
    "instance_ids": [],
    "document": "AWS-RunShellScript",
    "working_directory": "/opt/driftgate",
    "commands": [
      "set -euo pipefail",
      "git fetch --quiet origin",
      "git checkout --quiet --detach {commit_id}",
      "export DRIFTGATE_RUN_ID={run_id} DRIFTGATE_COMMIT_ID={commit_id}",
      "export DRIFTGATE_BUNDLE_URI=s3://{bundle_bucket}/{bundle_key}",
      "deploy/build.sh"
    ]
  },
  "deploy": {
    "application_name": "driftgate",
    "deployment_group_name": "driftgate-serving",
    "bundle_bucket": "",
    "bundle_key": "bundles/{commit_id}.zip",
    "bundle_type": "zip"
  },
  "approval": {
    "topic_arn": "",
    "function_url": "",
    "timeout_seconds": 1800
  }
}
