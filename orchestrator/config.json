{
  "region": "us-east-1",
  "branch": "main",
  "run_bucket": "",
  "run_prefix": "runs/",
  "build": {
    "instance_ids": [],
    "document": "AWS-RunShellScript",
    "working_directory": "/opt/driftgate",
    "commands": [
      "cd {working_directory} && git fetch && git checkout {commit_id} && deploy/build.sh --commit {commit_id} --run-id {run_id}"
    ]
  },
  "deploy": {
    "application_name": "driftgate",
    "deployment_group_name": "driftgate-serving",
    "bundle_bucket": "",
    "bundle_key": "bundles/{commit_id}.zip",
    "bundle_type": "zip"
  },
  "approval": {
    "topic_arn": "",
    "function_url": "",
    "timeout_seconds": 1800
  }
}
