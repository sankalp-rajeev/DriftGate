{
  "region": "us-east-1",
  "branch": "main",
  "run_bucket": "",
  "run_prefix": "runs/",
  "lock_ttl_seconds": 7200,
  "build": {
    "host_tag": {"key": "Role", "value": "build-host"},
    "host_idle_stop_seconds": 1800,
    "document": "AWS-RunShellScript",
    "execution_timeout_seconds": 7200,
    "working_directory": "/opt/driftgate",
    "commands": [
      "cd {working_directory} && git fetch && git checkout {commit_id} && deploy/build.sh --commit {commit_id} --run-id {run_id}"
    ]
  },
  "deploy": {
    "application_name": "driftgate",
    "deployment_group_name": "driftgate-serving",
    "bundle_bucket": "",
    "bundle_key": "bundles/{commit_id}.zip",
    "bundle_type": "zip"
  },
  "approval": {
    "topic_arn": "",
    "function_url": "",
    "timeout_seconds": 1800
  },
  "reference": {
    "key": "",
    "revision": "",
    "commands": [
      "set -euo pipefail",
      "cd {working_directory} && git fetch && git checkout {reference_revision}",
      "uv sync --frozen --no-dev",
      ".venv/bin/python -m gate.serve --config serving/config.yaml & server=$!",
      "trap 'kill $server' EXIT",
      "until curl -fs http://127.0.0.1:8080/health >/dev/null; do sleep 2; done",
      ".venv/bin/python -m gate reference --seed 0 --reference-key {reference_key} --s3-uri s3://{run_bucket} --upload"
    ]
  }
}
