# Deploy-time settings for the CodeDeploy hooks (FR-17, FR-18). KEY=VALUE, no quotes.
# Precedence: variables already in the environment, then /etc/driftgate/deploy.env (written by
# the instance user data in cloudformation/codedeploy.yaml), then these defaults.

# Where CodeDeploy installs the revision (must match `files.destination` in appspec.yml).
DRIFTGATE_APP_DIR=/opt/driftgate
# llama-server listen address on the instance; the port must match the network stack
# ServingPort (8080). Local runs of the hooks use 8081.
DRIFTGATE_SERVING_HOST=0.0.0.0
DRIFTGATE_SERVING_PORT=8080
# Serving config in the revision, and the instance copy rendered from it with the host/port above.
DRIFTGATE_SERVING_CONFIG=serving/config.yaml
DRIFTGATE_INSTANCE_SERVING_CONFIG=/etc/driftgate/serving.yaml
# Gate (ValidateService): config with mode/thresholds/reference, budget level and seed.
# The gate mode is in the gate config: report until gate/thresholds.json exists, then enforce.
DRIFTGATE_GATE_CONFIG=gate/config.yaml
DRIFTGATE_GATE_LEVEL=L1
DRIFTGATE_GATE_SEED=0
# Where hook outputs (verdict, measurement) go on the instance.
DRIFTGATE_RUN_DIR=/var/lib/driftgate/deployments
# Seconds ApplicationStart / ValidateService wait for llama-server /health.
DRIFTGATE_HEALTH_TIMEOUT_S=600
# llama.cpp source checkout and binaries on the instance (built at the serving/llama_cpp.lock commit).
DRIFTGATE_LLAMA_CPP_DIR=/opt/llama.cpp
LLAMA_CPP_BIN=/opt/llama.cpp/build/bin
# Storage bucket (driftgate-storage stack). The reference key is derived from gate/baseline.yaml
# and the instance type (PRD 6.8). Empty bucket = skip S3 (local runs): the reference must then
# already be in the local reference store.
DRIFTGATE_BUCKET=
# 1 = use systemd for llama-server (instances). Local runs set 0 and start llama-server themselves.
DRIFTGATE_SYSTEMD=1
# 1 = ValidateService publishes the verdict to CloudWatch (FR-20); local runs set 0.
DRIFTGATE_PUBLISH_METRICS=1
DRIFTGATE_REGION=us-east-1
# Metric dimension when CodeDeploy's DEPLOYMENT_GROUP_NAME is not set (local runs).
DRIFTGATE_DEPLOYMENT_GROUP=driftgate-serving
# 1 = ValidateService exits non-zero whatever the gate says (T-13 rollback drills, PRD 6.8).
DRIFTGATE_FORCE_FAIL=0
