{
  "description": "NFR-06 least-privilege controls. status is 'enforced' (applied to a real resource in the Lab) or 'documented-only' (written policy; the Lab runs the principal as LabRole because role creation is denied). applied_in names the file that applies an enforced control, or null if no task applies it yet.",
  "placeholders": {
    "AccountId": "Lab account id",
    "Region": "us-east-1 (NFR-08)",
    "ArtifactBucket": "S3 bucket for models, reference logits, bundles, build logs and run records",
    "OrchestratorFunction": "Lambda orchestrator function name (T-25)",
    "ApprovalFunction": "Approval handler function name (T-26)",
    "ApprovalTopic": "SNS approval topic name (T-26)",
    "RulePrefix": "Name prefix shared by the pipeline's EventBridge rules (T-25)",
    "CodeDeployApp": "CodeDeploy application name (T-12)",
    "DeploymentGroup": "CodeDeploy deployment group name (T-12)",
    "TargetGroup": "ALB target group name (T-12)",
    "Repository": "CodeCommit repository name",
    "MetricNamespace": "CloudWatch namespace of the gate metric (T-13)"
  },
  "controls": [
