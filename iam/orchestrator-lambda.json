{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunRecords",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::${ArtifactBucket}/runs/*"
    },
    {
      "Sid": "ListRunRecords",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${ArtifactBucket}",
      "Condition": {"StringLike": {"s3:prefix": ["runs/*"]}}
    },
    {
      "Sid": "ReadBuildLogs",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::${ArtifactBucket}/build-logs/*"
    },
    {
      "Sid": "RunBuildOnBuildHostOnly",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:${Region}:${AccountId}:instance/*",
      "Condition": {"StringEquals": {"ssm:resourceTag/Role": "build-host"}}
    },
    {
      "Sid": "RunShellScriptDocumentOnly",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:${Region}::document/AWS-RunShellScript"
    },
    {
      "Sid": "ReadCommandStatus",
      "Effect": "Allow",
      "Action": ["ssm:GetCommandInvocation", "ssm:ListCommandInvocations"],
      "Resource": "*"
    },
    {
      "Sid": "ApprovalEmail",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:${Region}:${AccountId}:${ApprovalTopic}"
    },
    {
      "Sid": "StartAndTrackDeployment",
      "Effect": "Allow",
      "Action": ["codedeploy:CreateDeployment", "codedeploy:GetDeployment"],
      "Resource": "arn:aws:codedeploy:${Region}:${AccountId}:deploymentgroup:${CodeDeployApp}/${DeploymentGroup}"
    },
    {
      "Sid": "DeploymentConfig",
      "Effect": "Allow",
      "Action": "codedeploy:GetDeploymentConfig",
      "Resource": "arn:aws:codedeploy:${Region}:${AccountId}:deploymentconfig:CodeDeployDefault.OneAtATime"
    },
    {
      "Sid": "RegisterRevision",
      "Effect": "Allow",
      "Action": ["codedeploy:RegisterApplicationRevision", "codedeploy:GetApplicationRevision"],
      "Resource": "arn:aws:codedeploy:${Region}:${AccountId}:application:${CodeDeployApp}"
    },
    {
      "Sid": "OwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:${Region}:${AccountId}:log-group:/aws/lambda/${OrchestratorFunction}:*"
    }
  ]
}
