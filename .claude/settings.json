{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(uv:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(cmake:*)",
      "Bash(tmux:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(cfn-lint:*)",
      "Bash(docker compose:*)",
      "Bash(curl:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Bash(tree:*)",
      "Bash(sha256sum:*)",
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(aws:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(~/.aws/**)"
    ]
  }
}
